{# Accordion item
  ## Variables ##
  # accordion_size – inherited from the parent Accordion.
  # accordion_variant – inherited from the parent Accordion.
  # accordion_trigger_tag – Set the tag for the label content (inside the summary).
  # accordion_item_disabled – Optional, set the item to disabled state.
  # accordion_item_expanded – Optional, open the accordion on start.
  # accordion_item_label_id – Required. Unique. Identifies the summary.
  # accordion_item_content_id – Required. Unique. Identifies the content.
  # accordion_item_icon – Optional. Adds svg icon before the label text.
  # accordion_item_label – Required. String on the summary.
  # accordion_item_annotation – Optional. Extra explanation on the summary.
  # accordion_item_content – Required. Content of the accordion.

  ## Notes ##
  # DS 4.6 markup contract: native <details>/<summary>; the arrow rotation
  # keys off summary[aria-expanded], which gov-accordion-item.js keeps in
  # sync with the native open state.
#}
{{ attach_library('gov_cz/gov-accordion-item') }}
{% set accordion_variant = accordion_variant|default('primary') %}
<div class="gov-accordion-item" role="listitem" size="{{ accordion_size|default('m') }}" variant="{{ accordion_variant }}" color="{{ accordion_variant == 'secondary' ? 'neutral' : accordion_variant }}" {{ accordion_item_disabled ? 'disabled=""' }}>
  <details id="{{ accordion_item_content_id }}" {{ accordion_item_expanded ? 'open' }} {{ accordion_item_disabled ? 'aria-disabled="true"' }}>
    <summary id="{{ accordion_item_label_id }}" aria-expanded="{{ accordion_item_expanded ? 'true' : 'false' }}" {{ accordion_item_disabled ? 'tabindex="-1"' }}>
      {% if accordion_item_icon %}
        <span class="gov-accordion-item__icon">
          <span class="gov-icon" slot="icon" aria-hidden="true">{{ source(accordion_item_icon, ignore_missing = true) }}</span>
        </span>
      {% endif %}
      <span class="gov-accordion-item__title">
        <{{ accordion_trigger_tag ?? 'h3' }} slot="label">{{ accordion_item_label }}</{{ accordion_trigger_tag ?? 'h3' }}>
        {% if accordion_item_annotation %}
          <span slot="annotation">{{ accordion_item_annotation }}</span>
        {% endif %}
      </span>
      <span class="gov-accordion-item__right">
        <span class="gov-accordion-item__arrow">
          <span class="gov-icon" aria-hidden="true">{{ source('@gov_cz/assets/gov-design-system/gov-icons/components/chevron-down.svg') }}</span>
        </span>
      </span>
    </summary>
    <div class="gov-content gov-accordion-item__content">
      {{ accordion_item_content }}
    </div>
  </details>
</div>
